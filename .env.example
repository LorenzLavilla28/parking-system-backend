# Optional overrides for Docker Compose.
# The defaults in deploy/docker-compose.yml and appsettings.json work for local testing.

API_PORT=5274
POSTGRES_PORT=5432
POSTGRES_DB=parkingsaas
POSTGRES_USER=parking
POSTGRES_PASSWORD=parking

# Use a unique value with at least 32 characters outside local development.
JWT_SIGNING_KEY=dev-only-signing-key-do-not-use-in-production-1234567890

# The API allows the frontend to call it from this origin.
CORS_ALLOWED_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# Keep email disabled unless SMTP settings are provided.
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_SSL=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@parking.local
EMAIL_FROM_NAME=ParkingSaaS
EMAIL_APP_BASE_URL=http://localhost:5173

# Optional; payment requests will not work until a PayMongo test key is set.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Set true when you intentionally want to wipe and reseed the DB on startup.
DATABASE_RESET_ON_STARTUP=false
