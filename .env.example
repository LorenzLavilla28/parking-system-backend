# Optional overrides for Docker Compose.
# The defaults in deploy/docker-compose.yml and appsettings.json work for local testing.

API_PORT=5274
POSTGRES_PORT=5432
POSTGRES_DB=parkingsaas
POSTGRES_USER=parking
POSTGRES_PASSWORD=parking

# Use a unique value with at least 32 characters outside local development.
JWT_SIGNING_KEY=dev-only-signing-key-do-not-use-in-production-1234567890

# The API allows the frontend to call it from this origin.
CORS_ALLOWED_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# Keep email disabled unless Microsoft Graph app-only settings are provided.
EMAIL_ENABLED=false
EMAIL_TENANT_ID=
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
EMAIL_FROM_ADDRESS=no-reply@parking.local
EMAIL_FROM_NAME=PBP Parking
EMAIL_APP_BASE_URL=http://localhost:5173

# PayMongo is tenant-owned. Do not put a global PayMongo key here.
# Connect each tenant from the tenant Payment settings page instead.
PAYMONGO_WEBHOOK_BASE_URL=http://localhost:5274

# AWS credentials used by the API container to create/read tenant secrets.
# Keep these values only in the untracked .env file. Prefer short-lived IAM
# credentials or a local IAM user limited to the required Secrets Manager actions.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_SECRETS_ENABLED=true

# Set true when you intentionally want to wipe and reseed the DB on startup.
DATABASE_RESET_ON_STARTUP=false
