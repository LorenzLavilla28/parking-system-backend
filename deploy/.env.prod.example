# Copy this file to .env.prod on the EC2 instance and run chmod 600 .env.prod.
# Never commit the real file.

POSTGRES_DB=parkingsaas
POSTGRES_USER=parking
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD

# At least 32 random characters. Changing this logs out all active users.
JWT_SIGNING_KEY=REPLACE_WITH_A_LONG_RANDOM_JWT_SIGNING_KEY

# Enable only for the first successful boot. Remove the password and set false
# immediately after the platform administrator has been created.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_FIRST_NAME=Platform
BOOTSTRAP_ADMIN_LAST_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@pbp-parking.app
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_TEMPORARY_PASSWORD

EMAIL_ENABLED=false
EMAIL_SECRET_NAME=parking-saas/production/email
EMAIL_FROM_ADDRESS=no-reply@pbp-parking.app
EMAIL_FROM_NAME=PBP Parking
