{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=parkingsaas;Username=parking;Password=parking"
  },
  "Jwt": {
    "Issuer": "ParkingSaaS",
    "Audience": "ParkingSaaS",
    "SigningKey": "REPLACE_VIA_SECRETS_MANAGER_OR_SSM_minimum_32_chars",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Lockout": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "PasswordReset": {
    "TokenLifetimeMinutes": 60
  },
  "PublicUrls": {
    "BaseUrl": "https://parking.example.com"
  },
  "Pricing": {
    "FeeQuoteMinutes": 10
  },
  "PayMongo": {
    "BaseUrl": "https://api.paymongo.com/v1",
      "ValidateCredentialsWithProvider": true,
    "WebhookBaseUrl": "",
    "SecretNamePrefix": "parking-saas/tenants",
    "CredentialCacheMinutes": 10,
    "PaymentMethodTypes": [ "gcash", "qrph", "card" ],
    "ReconcileIntervalSeconds": 120,
    "ReconcilePendingOlderThanMinutes": 3
  },
  "AwsSecrets": {
    "Enabled": true,
    "Region": "ap-southeast-1"
  },
  "TenantBranding": {
    "BucketName": "parking-system-tenant-assets",
    "Region": "ap-southeast-1",
    "MaxLogoBytes": 2097152
  },
  "Email": {
    "Enabled": false,
    "SecretName": "",
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "FromAddress": "no-reply@parking.example.com",
    "FromName": "PBP Parking",
    "AppBaseUrl": "https://app.parking.example.com",
    "DispatchIntervalSeconds": 30,
    "DispatchBatchSize": 25,
    "MaxAttempts": 5,
    "OperationsSummaryEnabled": true,
    "OperationsSummarySweepMinutes": 1
  },
  "LookupThrottle": {
    "CaptchaAfterFailures": 3,
    "BlockAfterFailures": 8,
    "BlockMinutes": 15,
    "WindowMinutes": 15
  },
  "PlateScanning": {
    "ModelPath": "Models/LicensePlateDetector_YOLOv8n.onnx",
    "ConfidenceThreshold": 0.12,
    "IouThreshold": 0.7,
    "CropPaddingRatio": 0.35,
    "MinimumCropAspectRatio": 3.2,
    "MaxDetectionCandidates": 3,
    "MaxImageBytes": 10485760,
    "MaxImageDimension": 1920,
    "MaxConcurrentScans": 1,
    "MaxQueuedScans": 2,
    "PaddleModelPath": "Models/PaddleOCR",
    "OcrConfidenceThreshold": 0.8
  },
  "DataProtection": {
    "KeyRingPath": ""
  },
  "Cors": {
    "AllowedOrigins": [ "https://app.parking.example.com" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*"
}
